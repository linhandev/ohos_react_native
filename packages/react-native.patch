+
+  setTranslucent(translucent: boolean): void {
+    throw new UnsupportedByPlatformError();
+  }
+
+  updatePropsStack(oldProps: any, mergedProps: any): void {
+    throw new UnsupportedByPlatformError();
+  }
+}
